supabase/.branches/
supabase/.temp/
supabase/.env
supabase/.env.*

# ---------------- PRISMA / DRIZZLE ----------------
prisma/migrations/dev.db*
*.db
*.db-journal

# ---------------- LOGS ----------------
logs/
*.log

# ---------------- OS FILES ----------------
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---------------- IDE / EDITORS ----------------
.vscode/*
