# ---------------- NEXT.JS ----------------
.next/
out/
build/
dist/
.swc/
next-env.d.ts

# ---------------- VITE ----------------
.vite/
*.local

# ---------------- NODE ----------------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npm
.node_repl_history
*.tgz

# ---------------- TYPESCRIPT ----------------
