!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# ---------------- CACHE ----------------
.cache/
.parcel-cache/
.eslintcache
.turbo/
.vercel/
.netlify/

# ---------------- TEST / COVERAGE ----------------
coverage/
.nyc_output/
*.lcov

# ---------------- MISC ----------------
*.pem
.vercel
.netlify

# ---------------- SCRATCH / REPORTS / BACKUPS ----------------
